<%# locals: (contact:, size: :small) %>
<% if contact.has_photo? %>
  <%= image_tag contact_photo_path(contact, v: contact.etag.delete('"')), alt: "", class: "avatar avatar--#{size}", loading: "lazy" %>
<% else %>
  <span class="avatar avatar--<%= size %> avatar--initials" aria-hidden="true"><%= contact.initials %></span>
<% end %>
