<% content_for :title, @group ? "#{@group.name} · Rolodex" : "Contacts · Rolodex" %>

<div class="row row--between">
  <h1>Contacts</h1>
  <div class="row">
    <%= link_to "Import .vcf", new_import_path, class: "button" %>
    <%= link_to "New contact", new_contact_path, class: "button button--primary" %>
  </div>
</div>

<%= form_with url: contacts_path, method: :get, class: "row search",
      data: { controller: "search", turbo_frame: "contact_results", turbo_action: "replace" } do |form| %>
  <%= form.search_field :q, value: @query, placeholder: "Search name, organization, email, or phone",
        "aria-label": "Search contacts", autocomplete: "off", data: { action: "input->search#search" } %>
  <% if @groups.any? %>
    <%= form.select :group, options_from_collection_for_select(@groups, :id, :name, @group&.id), { include_blank: "All contacts" },
          "aria-label": "Group", class: "search__group", data: { action: "change->search#search" } %>
  <% end %>
  <label class="row search__option">
    <%= form.check_box :archived, { checked: @include_archived, data: { action: "change->search#search" } }, "1", nil %>
    Include archived
  </label>
<% end %>

<%= turbo_frame_tag "contact_results", target: "_top" do %>
  <%= render "contacts/list", contacts: @contacts,
        empty_message: @query.present? ? "No contacts match “#{@query}”." : "No contacts yet." %>
<% end %>
