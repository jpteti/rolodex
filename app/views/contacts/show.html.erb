<% content_for :title, "#{@contact.display_name} · Rolodex" %>

<p><%= @contact.archived? ? link_to("← Archive", archived_contacts_path) : link_to("← Contacts", contacts_path) %></p>

<div class="row row--between">
  <h1><%= @contact.display_name %></h1>
  <div class="row">
    <% if @contact.archived? %>
      <%= button_to "Unarchive", contact_archive_path(@contact), method: :delete, class: "button" %>
    <% else %>
      <%= button_to "Archive", contact_archive_path(@contact), class: "button" %>
    <% end %>
  </div>
</div>

<% if @contact.archived? %>
  <p class="flash flash--archived">Archived <%= l @contact.archived_at, format: :long %>. This contact is hidden from your devices.</p>
<% end %>

<div class="card">
  <dl class="details">
    <% if @contact.given_name %><dt>First name</dt><dd><%= @contact.given_name %></dd><% end %>
    <% if @contact.family_name %><dt>Last name</dt><dd><%= @contact.family_name %></dd><% end %>
    <% if @contact.organization %><dt>Organization</dt><dd><%= @contact.organization %></dd><% end %>
    <% @contact.card.all("EMAIL").each do |email| %>
      <dt><%= @contact.card.label_for(email) || "email" %></dt>
      <dd><%= mail_to email.text %></dd>
    <% end %>
    <% @contact.card.all("TEL").each do |phone| %>
      <dt><%= @contact.card.label_for(phone) || "phone" %></dt>
      <dd><%= link_to phone.text, "tel:#{phone.text.gsub(/[^\d+]/, '')}" %></dd>
    <% end %>
  </dl>
</div>
